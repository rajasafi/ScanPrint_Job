# Backend URL. Used only after explicit VITE_API_ENABLED=true.
VITE_API_BASE_URL=http://localhost:8080
# false = pure offline mockup (no requests at all).
# true  = allow sign-in/signup/upload/job calls to VITE_API_BASE_URL.
# Signup also needs the API to allow it: dev profile defaults to registration
# enabled; production defaults to disabled (ALLOW_PUBLIC_REGISTRATION).
VITE_API_ENABLED=false
